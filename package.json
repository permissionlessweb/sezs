{
  "name": "sezs",
  "version": "0.1.0",
  "scripts": {
    "build": "turbo run build --continue --filter=@sezs/app...",
    "dev": "pnpm --filter @sezs/app dev",
    "format": "prettier --write \"**/*.{css,json,md}\" && turbo run format --continue --parallel",
    "lint": "turbo run lint --continue --parallel",
    "test": "vitest",
    "sezs": "pnpm --filter @sezs/app"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.8",
    "turbo-ignore": "^2.5.8",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "prettier": "@sezs/config/prettier",
  "private": true,
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "pnpm": {
    "overrides": {
      "@types/react": "^18.2.0",
      "@types/react-dom": "^18.2.0"
    }
  }
}

{
  "name": "sezs-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "python3 scripts/sync-from-source.py",
    "predev": "python3 scripts/sync-from-source.py",
    "prebuild": "python3 scripts/sync-from-source.py",
    "dev": "vocs dev --host 127.0.0.1",
    "build": "vocs build && bash scripts/prepare-static.sh",
    "preview": "vocs preview --host 127.0.0.1",
    "serve": "python3 -m http.server 3054 --bind 127.0.0.1 --directory out"
  },
  "devDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vocs": "2.8.5",
    "waku": "1.0.0-beta.9",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "vocs@2.8.5": "patches/vocs@2.8.5.patch"
    }
  }
}

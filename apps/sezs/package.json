{
  "name": "@sezs/app",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 3051 -H 127.0.0.1",
    "build": "next build",
    "start": "npx serve out -p 3050",
    "ts": "tsc --noEmit --incremental",
    "test:auth": "node --test src/auth/e2e-node.mjs src/auth/e2e-http.mjs",
    "test:query": "node --test src/query/query.test.mjs",
    "test:lane": "node --test src/gallery/e2e-node.mjs src/event/door-e2e.mjs src/auth/e2e-node.mjs src/auth/e2e-http.mjs",
    "test:e2e": "node e2e/guest-flow.e2e.mjs",
    "test:splash": "node --test dev/splash/lib.test.mjs",
    "test:ticket": "node --test src/ticket/ticket.test.mjs src/ticket/ticket-kdf.test.mjs src/ticket/ticket-auth.test.mjs src/event/api.test.mjs src/ticket/transport/transport.test.mjs src/ticket/v2/ticket-v2.test.mjs dev/splash/lib.test.mjs",
    "test:zafu": "node --test src/ticket/ticket-kdf.test.mjs e2e/minirelay-zirc.e2e.mjs",
    "localterp": "bash dev/localterp/start.sh",
    "localterp:upgrade-v2": "node dev/localterp/upgrade-v2.mjs",
    "test:ticket-v2": "node --test src/ticket/v2/ticket-v2.test.mjs",
    "test:ticket-v2-e2e": "node e2e/ticket-v2-flow.e2e.mjs",
    "e2e:shots-v9": "node e2e/shots-v9.mjs",
    "e2e:shots-v10": "node e2e/shots-v10.mjs",
    "test:payroll": "node --test dev/splash/live-roles.test.mjs dev/splash/chain-payouts.test.mjs dev/splash/chain-watchers.test.mjs src/auth/roles.test.mjs src/pay/bech32.test.mjs src/frost/zafu-cipher.test.mjs src/frost/xeddsa.test.mjs src/frost/zafu-addresses.test.mjs",
    "e2e:shots-payroll": "node e2e/shots-payroll.mjs",
    "test:local-env": "node --test e2e/local-env.e2e.mjs",
    "e2e:shots-local-env": "node e2e/shots-local-env.mjs",
    "dev:backend": "echo 'start sezs-server (127.0.0.1:3058) and sezs-outpost (127.0.0.1:3061); see just sezs-server / just sezs-outpost'"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "jsqr": "^1.4.0",
    "next": "^13.5.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recoil": "^0.7.7",
    "@zafu/zid": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "@sezs/config": "workspace:*"
  }
}

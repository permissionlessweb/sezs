# Email auth environment names. Copy to a local untracked file if needed.
# Never put secrets in git, in docs, or in command lines that get logged.
# SEZS_EMAIL_FROM is not a secret; the default address is recorded here.

# Public From address (default sezs@permissionless.money)
# SEZS_EMAIL_FROM=sezs@permissionless.money

# HMAC key for signed sezs_splash email session tokens (required in production)
# SEZS_EMAIL_SESSION_SECRET=

# Delivery adapter. In development the default is the local 0600 file sink.
# Production must not use the file sink. Leave unset or "none" until a provider is chosen.
# SEZS_EMAIL_PROVIDER=
# SEZS_EMAIL_OUTBOX_DIR=

# Allowed web origins (comma-separated)
# SEZS_EMAIL_ALLOWED_ORIGINS=

# Standalone server bind (loopback only unless SEZS_ALLOW_NON_LOOPBACK=1)
# SEZS_EMAIL_HOST=
# SEZS_EMAIL_PORT=
# SEZS_EMAIL_DB=
# SEZS_ALLOW_NON_LOOPBACK=
# SEZS_TRUST_PROXY=

# Optional / adaptive proof-of-work on /request (0 disables a fixed cost)
# SEZS_EMAIL_POW_BITS=
# SEZS_EMAIL_POW_AFTER=

# Next rewrite to a standalone email-auth server (otherwise splash serves the routes)
# SEZS_EMAIL_AUTH_URL=
# NEXT_PUBLIC_SEZS_EMAIL_AUTH_URL=

# Splash board (existing). Email routes also attach here when SEZS_EMAIL_AUTH_URL is unset.
# SEZS_SPLASH=
# NEXT_PUBLIC_SEZS_SPLASH=
# SEZS_SPLASH_PORT=
# SEZS_SPLASH_DIR=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speak-ez.sessions/schemas/narration-transcript-v1.1.json",
  "title": "SEZS narration transcript",
  "description": "Versioned spoken-word transcript for a walkthrough guide. First-person product narration, aligned to trail steps, surface-flow nodes, and earmarked video slots.",
  "x-sezs-schema-version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "audience",
    "prerequisites",
    "user_constraints",
    "flow_graph",
    "event",
    "timing",
    "audio",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "draft",
        "has_gaps"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "flow_graph": {
      "type": "string",
      "pattern": "\\.mmd$"
    },
    "derived_graphs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "producer_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_speech_seconds",
        "words_per_minute"
      ],
      "properties": {
        "estimated_speech_seconds": {
          "type": "number",
          "minimum": 0
        },
        "words_per_minute": {
          "type": "number",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tts",
        "human"
      ],
      "properties": {
        "tts": {
          "$ref": "#/$defs/audioTrack"
        },
        "human": {
          "$ref": "#/$defs/audioTrack"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "draft",
            "final"
          ]
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "narration_ste",
        "on_screen_action",
        "trail_step",
        "expected_ui",
        "video_slots",
        "transitions",
        "estimated_speech_seconds",
        "word_count",
        "audio_render",
        "flow_node"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "gap"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "intro",
            "step",
            "outro"
          ]
        },
        "gap": {
          "type": [
            "string",
            "null"
          ]
        },
        "narration_ste": {
          "type": "string",
          "minLength": 1
        },
        "on_screen_action": {
          "type": "string",
          "minLength": 1
        },
        "producer_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "flow_node": {
          "type": "string",
          "minLength": 1
        },
        "trail_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_ui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route"
          ],
          "properties": {
            "route": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "visible_labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "video_slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/videoSlot"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "estimated_speech_seconds": {
          "type": "number",
          "minimum": 0
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "audio_render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tts_path",
            "human_path"
          ],
          "properties": {
            "tts_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "human_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "take": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "videoSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source_app",
        "source_device",
        "duration_seconds",
        "path",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "web-capture",
            "mobile-wallet-capture",
            "device-camera",
            "still-screenshot",
            "title-card"
          ]
        },
        "source_app": {
          "type": "string"
        },
        "source_device": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "captured",
            "placeholder"
          ]
        },
        "capture_checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "duration_seconds"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "dissolve",
            "wipe",
            "hold",
            "match-cut"
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

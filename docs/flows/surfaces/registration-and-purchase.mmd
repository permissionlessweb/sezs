flowchart TB

    Tickets["pages/tickets.tsx · Tickets"]:::web --> Rail["Select ZEC or Penumbra"]:::web
    Rail --> Qty["Set Number of tickets"]:::web
    Qty --> Continue["Select Continue to checkout"]:::web
    Continue --> Checkout["CheckoutPanel.start · Shielded ZEC"]:::web
    Checkout --> MakeReq["Select Make a ZEC request for Zafu"]:::web
    MakeReq --> ZipQr["TicketQr ZIP-321 payment request"]:::web
    ZipQr --> OpenZafu["Select Open in Zafu"]:::wallet
    ZipQr --> ScanWallet["Scan the request in Zashi or Ywallet"]:::wallet
    OpenZafu --> ConfirmPay["Confirm payment in the wallet"]:::wallet
    ScanWallet --> ConfirmPay
    ConfirmPay --> CheckPay["Select Check for payment"]:::web
    CheckPay --> Paid["Payment is on the guest list"]:::web
    Paid --> Printable["Link Open the printable ticket · /ticket"]:::web
    RegisterPage["pages/register.tsx · Register to take part"]:::web --> KeyField["Enter One-time registration key"]:::web
    KeyField --> NameField["Enter Name or act"]:::web
    NameField --> Addr["Enter ZEC and UM addresses"]:::web
    Addr --> RegisterBtn["Select Register"]:::web
    AdminIssue["ParticipantsPanel · Issue a registration key"]:::usher --> RegisterPage

